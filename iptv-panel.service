[Unit]
Description=IPTV Panel Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/mqltv
ExecStart=/root/mqltv/iptv-panel
Restart=always
RestartSec=5
StandardOutput=append:/root/mqltv/server.log
StandardError=append:/root/mqltv/server.log

# Environment variables
Environment="DB_PATH=/home/dindin/mqltv/iptv.db"
# Contoh: Environment="HOST=203.0.113.10:8080"
# Atau dengan domain: Environment="HOST=iptv.yourdomain.com"
=======
Environment="DB_PATH=/root/mqltv/iptv.db"

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
